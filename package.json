{
  "name": "axios-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter axios run build",
    "prepare:version": "pnpm --filter axios run prepare:version",
    "lint": "pnpm --filter axios run lint",
    "fix": "pnpm --filter axios run fix",
    "test": "pnpm --filter axios run test",
    "test:vitest": "pnpm --filter axios run test:vitest",
    "test:vitest:unit": "pnpm --filter axios run test:vitest:unit",
    "test:vitest:browser": "pnpm --filter axios run test:vitest:browser",
    "test:vitest:browser:headless": "pnpm --filter axios run test:vitest:browser:headless",
    "test:vitest:watch": "pnpm --filter axios run test:vitest:watch",
    "test:build:artifacts": "pnpm --filter axios run test:build:artifacts",
    "pack:axios": "pnpm --dir packages/axios pack --pack-destination ../../artifacts",
    "version:axios": "pnpm --dir packages/axios exec npm version --no-git-tag-version",
    "docs:dev": "pnpm --filter @axios/docs run docs:dev",
    "docs:build": "pnpm --filter @axios/docs run docs:build",
    "start": "pnpm --filter @axios/sandbox start",
    "prepare": "husky",
    "test:e2e": "pnpm --filter @axios/e2e test",
    "test:e2e:node": "pnpm --filter @axios/e2e run test:node",
    "test:e2e:browser": "pnpm --filter @axios/e2e run test:browser",
    "test:e2e:bun": "pnpm --filter @axios/e2e run test:bun",
    "test:e2e:deno": "pnpm --filter @axios/e2e run test:deno",
    "test:e2e:pack": "pnpm --filter @axios/e2e run pack"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4"
  },
  "commitlint": {
    "rules": {
      "header-max-length": [
        2,
        "always",
        130
      ]
    },
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,json,md,yml,yaml}": "prettier --write"
  }
}
